# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# HTTPS-адрес, где открывается вебапп (Telegram WebApp работает только по HTTPS)
WEBAPP_URL=https://shop.example.com
# ID группы менеджеров, куда падают заказы (бот должен быть её участником)
MANAGER_CHAT_ID=-1001234567890
# Telegram ID админов через запятую: /admin, отчёты, управление наличием, бэкапы БД
ADMINS_ID=111111111,222222222
# Координаты точки, откуда едет доставка: "широта, долгота"
SHOP_COORD="55.751244, 37.618423"
# Ключ Яндекс Геокодера (адрес → координаты), developer.tech.yandex.ru
YANDEX_TOKEN=

# --- Магазин ---
SHOP_NAME=Зерно
# Город для геокодера и часовой пояс отчётов/расписания
CITY_NAME=Москва
SHOP_TZ=Europe/Moscow
# Контакт менеджера для клиентов
MANAGER_CONTACT=@manager
# Статичная ссылка на оплату по СБП (сумму клиент вводит сам)
PAY_LINK=

# --- Необязательные ---
# Тема в группе менеджеров, если в группе включены «Темы»
MANAGER_TOPIC_ID=
# Бот и магазин только для подписчиков канала (@username); бот должен быть админом канала
REQUIRED_CHANNEL=
# Акция на всё меню: процент и последний день действия (YYYY-MM-DD)
DISCOUNT_PERCENT=0
DISCOUNT_UNTIL=
# Адрес OSRM-маршрутизатора; без него расстояние = прямая × 1.4
OSRM_URL=http://osrm:5000
DB_NAME=shop.db
